# Helyi fejleszteshez (docker-compose.yml alapertelmezesekkel mukodik ezek nelkul is).
# Production-ben mind kotelezoen legyen sajat, eros ertek - lasd README/deploy jegyzetek.

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000

DB_USERNAME=botlobby
DB_PASSWORD=botlobby

# Vesszovel elvalasztott lista - a frontend(ek) tenyleges origin(je) production-ben,
# pl. https://botlobby.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
